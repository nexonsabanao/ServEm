# ServEm Cloud Functions — local/emulator environment template.
# Copy to `.env` inside this functions/ directory for the Firebase emulator
# suite. NEVER commit the real `.env`; production values live in Firebase
# App Hosting/Environment parameters and Secret Manager (`firebase
# functions:secrets:set <NAME>` or the Cloud Console), not in this file.
# Nothing here reaches the client bundle.

# --- CORS -------------------------------------------------------------
# Extra localhost origins allowed to call the callables (comma-separated).
# Production origins https://servem-ph.web.app and
# https://servem-ph.firebaseapp.com are always allowed and need no config.
ALLOWED_DEV_ORIGINS=http://localhost:5173,http://localhost:5180,http://localhost:3000

# --- Pricing / payouts -------------------------------------------------
# Platform commission as a decimal fraction of the subtotal (0.00 - 0.30).
# An optional config/platform Firestore doc with { feeRate: number }
# overrides this at runtime.
PLATFORM_FEE_RATE=0.10
# Minimum PHP a ServMate may request as a payout.
MIN_PAYOUT_PHP=1000

# --- Secrets (set via Secret Manager, shown here only as names) --------
# One-time bootstrap token for the FIRST admin (setAdminClaim). Granting via
# bootstrap only works for self-promotion and should be rotated/removed after
# the first admin exists. Generate: openssl rand -hex 32
ADMIN_BOOTSTRAP_TOKEN=

# PayMongo webhook signing secret (Webhooks page in the PayMo dashboard).
# When empty/unset, the paymongoWebhook endpoint fails closed with HTTP 503.
PAYMONGO_WEBHOOK_SECRET=

# --- Scheduled maintenance --------------------------------------------
# Audit-log retention is OFF by default. Only set true once deletion of old
# auditLog entries is an accepted policy. Retention days must be >= 30.
ENABLE_AUDIT_RETENTION=false
AUDIT_RETENTION_DAYS=365
