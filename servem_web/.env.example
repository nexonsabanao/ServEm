# ServEm web — environment template. Copy to `.env` and fill from:
# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
#
# The Firebase web config is PUBLIC by design: it ships inside every web
# bundle and grants no access by itself. Real access control lives in
# firestore.rules, storage.rules and the Cloud Functions in servem_web/functions.
# Never put a service-account key, an admin token or a payment secret in this
# file or anywhere in the client bundle — those are Functions secrets only:
#
#   firebase functions:secrets:set ADMIN_BOOTSTRAP_TOKEN --project <project-id>
#   firebase functions:secrets:set PAYMONGO_WEBHOOK_SECRET --project <project-id>
#
# Keep the browser API key restricted in Google Cloud: allow only the Hosting
# origins and localhost referrers, and enable Firebase App Check before launch.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloud Functions region — must match the region the functions are deployed to.
VITE_FUNCTIONS_REGION=asia-southeast1
