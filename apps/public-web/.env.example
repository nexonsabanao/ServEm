# Server-side API base URL, including /api/v1. Never put API secrets here.
API_BASE_URL=https://api.example.invalid/api/v1

# Public origin this site is served from, with no trailing slash. Required in
# production; local development falls back to http://localhost:3000. It must
# match the OAuth redirect URIs registered with each provider.
# APP_ORIGIN=https://www.example.com

# Google OAuth 2.0 web client. https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple Sign in with Apple: the Services ID, the team id, the key id, and the
# contents of the .p8 private key (escaped \n line breaks are accepted).
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# Transactional email, used for password recovery links (Resend). Without it the
# recovery endpoint answers 503 instead of pretending a mail was sent, and the
# /reset page still renders. https://resend.com/api-keys
# RESEND_API_KEY=

# The address recovery mail is sent from. Must be a domain verified with the
# provider; the default is the provider's own sandbox sender.
# EMAIL_FROM=ServEm <no-reply@example.com>

# The operator credential for the moderation console at /moderation. Unset means
# there is no console at all: /moderation is a 404 and every /api/moderation route
# answers 404. It must be at least 24 characters — a shorter value is treated as
# unset rather than as a weak key. Generate one with:
#   openssl rand -hex 32
# Rotating it ends every open console session, because the browser holds only a
# digest of it. This is not an account password, and no account can use it.
# SERVEM_MODERATION_TOKEN=

# Who the audit trail names for console actions. Defaults to "operator".
# SERVEM_MODERATION_ACTOR=ops-console
