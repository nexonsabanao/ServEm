[TEMPLATE]
# Server-side API base URL, including /api/v1. Never put API secrets here.
API_BASE_URL=https://api.example.invalid/api/v1

# Public origin this site is served from, with no trailing slash. Required in
# production; local development falls back to http://localhost:3000. It must
# match the OAuth redirect URIs registered with each provider.
# APP_ORIGIN=https://www.example.com

# Google OAuth 2.0 web client. https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple Sign in with Apple: the Services ID, the team id, the key id, and the
# contents of the .p8 private key (escaped \n line breaks are accepted).
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
